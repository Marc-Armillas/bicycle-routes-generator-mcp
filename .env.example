# Copy this file to .env and fill in your values. Never commit .env.

# Folder where GPX files are saved (created if missing). The OS may clean /tmp up.
MTB_GPX_DIR=/tmp/mtb-routes

# Contact sent in the User-Agent to Nominatim, Overpass and BRouter
# (required by Nominatim's usage policy). An email or a URL.
MTB_CONTACT=you@example.com

# Routing engine: brouter (default) or ors.
MTB_ENGINE=brouter

# BRouter server. Defaults to the public one (use it sparingly); for heavy use,
# run a local one with Docker and set http://localhost:17777
MTB_BROUTER_URL=https://brouter.de

# OpenRouteService API key (only if MTB_ENGINE=ors). Free at https://openrouteservice.org
ORS_API_KEY=

# Check protected areas with the Overpass API (1 = yes, 0 = no).
MTB_PROTECTED_AREAS=1

# Garmin exporter (optional, CLI only): command that starts the already installed
# Garmin MCP server, e.g.: uvx --from garmin-connect-mcp garmin-mcp
MTB_GARMIN_MCP_COMMAND=
